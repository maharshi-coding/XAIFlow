# Docker Compose configuration. Set a password before starting.
POSTGRES_USER=xaiflow
POSTGRES_PASSWORD=change-this-local-password
POSTGRES_DB=xaiflow
ARTIFACT_ROOT=/app/artifacts
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
MAX_UPLOAD_BYTES=20971520
MAX_BACKUP_BYTES=209715200
DRIFT_THRESHOLD=0.2
# Set this to a long random secret for portable backup recovery, or leave unset
# to use a generated persistent secret in the artifact volume.
# BACKUP_SIGNING_KEY=
